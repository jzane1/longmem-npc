# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor noise
Thumbs.db
.DS_Store

# Unity — Editor-generated output only. ANCHORED to unity\ (2026-07-28): these
# rules used to be unanchored at repo root, so `*.csproj` swallowed the
# hand-written client projects and needed a rescue commit (ae54af8) to
# un-ignore them. Anchoring means source outside unity\ is simply source.
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Ll]ogs/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Oo]bj/
unity/UserSettings/
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/.vs/
unity/.vscode/
# Captures are scratch by default, but a capture cited as VERIFICATION EVIDENCE
# has to exist in the repo or the citation is empty (2026-07-28). Note the
# trailing /* — a directory-level ignore cannot be undone by a negation inside
# it, so the contents are excluded rather than the directory.
unity/Captures/*
!unity/Captures/graybox-stage2-receipt.png
unity/Assets/Plugins/**/*.pdb
# Third-party editor bridge, embedded locally by its setup wizard; the
# Packages/manifest.json git URL re-resolves it on a fresh clone.
unity/Packages/com.coplaydev.unity-mcp/

# .NET build output (client\ has its own .gitignore for bin/ and obj/)
[Bb]in/
[Oo]bj/
!client/**/*.csproj
!client/**/*.sln

# Claude Code personal overrides
CLAUDE.local.md
.claude/settings.local.json

# The research folder is a ~117 MB store of 45 source PDFs — too big to upload,
# and not ours to redistribute. The WRITING that came out of it (FINDINGS.md,
# CHANGES-FROM-RESEARCH.md, the per-paper notes) moved into docs\research\ on
# 2026-07-28 and IS tracked: it is project work product, it is cited by eight
# other files, and it existed on exactly one machine until then.
Research Papers/
