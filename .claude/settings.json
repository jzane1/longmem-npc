{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(./.env)",
      "Read(.env)",
      "Read(./.env.*)",
      "Grep(./.env)",
      "Grep(.env)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(more .env*)",
      "Bash(Get-Content*.env*)",
      "Bash(gc .env*)",
      "Bash(Select-String*.env*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/format-on-edit.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/run-suite.ps1",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
